.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local development database
*.db
*.sqlite
*.sqlite3

# Agent-harness config is local, EXCEPT the checked-in subagent definitions
# (.claude/agents/spec-writer.md has always been tracked; without the
# negation a new agent file is silently ignored and never committed) and the
# SessionStart hook, which has to travel with the repo to build the container.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
